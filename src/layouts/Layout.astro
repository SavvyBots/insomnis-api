---
interface Props {
	title?: string;
	description?: string;
	lang?: 'es' | 'en';
}

const {
	title = 'Listing Stream | Anuncios nuevos en tiempo real',
	description =
		'Recibe en tiempo real los anuncios nuevos de los principales marketplaces de segunda mano en España.',
	lang = 'es',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0e0d" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		font-synthesis: none;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #0c0e0d;
	}

	body {
		min-width: 320px;
	}

	::selection {
		background: oklch(80% 0.14 155);
		color: #0c0e0d;
	}
</style>
