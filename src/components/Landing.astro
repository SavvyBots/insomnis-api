---
import { COPY, MARKETS, type LandingLanguage } from '../data/landing';
import { INTEGRATION_EXAMPLES } from '../data/integration-examples';
import { NORMALIZED_PAYLOAD_EXAMPLE } from '../data/payload-examples';
import { highlightCode, highlightJson } from '../lib/highlight-json';

interface Props {
	price?: number;
	defaultLang?: LandingLanguage;
}

const { price = 49, defaultLang = 'es' } = Astro.props;
const copy = COPY[defaultLang];
const normalizedPayloadHtml = await highlightJson(NORMALIZED_PAYLOAD_EXAMPLE);
const integrationExamples = await Promise.all(
	INTEGRATION_EXAMPLES.map(async (example) => ({
		...example,
		html: await highlightCode(example.code, example.language),
	})),
);
---

<main class="landing" data-landing data-default-lang={defaultLang}>
	<div class="shell">
		<header class="site-header">
			<div class="brand">
				<img
					class="brand-logo"
					src="/logos/listing-stream.png"
					width="1200"
					height="300"
					alt="Listing Stream"
					decoding="async"
				/>
			</div>

			<nav class="language-switcher" aria-label="Idioma / Language">
				<a
					class="language-button"
					href="/"
					lang="es"
					aria-label="Español"
					aria-current={defaultLang === 'es' ? 'page' : undefined}>ES</a
				>
				<a
					class="language-button"
					href="/en/"
					lang="en"
					aria-label="English"
					aria-current={defaultLang === 'en' ? 'page' : undefined}>EN</a
				>
			</nav>
		</header>

		<section class="hero" aria-labelledby="hero-title">
			<p class="command">
				<span aria-hidden="true">$ </span><span data-copy="cmd">{copy.cmd}</span>
			</p>
			<h1 id="hero-title" data-copy="h1">{copy.h1}</h1>
			<p class="hero-copy" data-copy="sub">{copy.sub}</p>
			<div class="connection">
				<span class="code-comment">// <span data-copy="snippetNote">{copy.snippetNote}</span></span>
				<span class="code-comment">// <span data-copy="platformsNote">{copy.platformsNote}</span></span>
				<code><span class="protocol">wss://</span>fructus.insomnis.site/feed?format=raw&amp;platforms=vinted,wallapop</code>
			</div>

			<div class="contact-row">
				<a class="primary-link" href="mailto:insomnisdev@gmail.com" data-copy="cta">{copy.cta}</a>
				<span class="email-hint" aria-hidden="true">insomnisdev@gmail.com</span>
			</div>
		</section>

		<section class="section" aria-labelledby="markets-title">
			<div class="section-heading">
				<h2 id="markets-title" data-copy="mkHead">{copy.mkHead}</h2>
				<span aria-hidden="true"></span>
			</div>

			<ul class="market-grid">
				{
					MARKETS.map((market) => (
						<li class="market-card">
							<span class="market-name">{market}</span>
							<span class="market-status">
								<span aria-hidden="true">● </span><span data-market-status>{copy.marketStatus}</span>
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="section" aria-labelledby="format-title">
			<div class="section-heading">
				<h2 id="format-title" data-copy="formatHead">{copy.formatHead}</h2>
				<span aria-hidden="true"></span>
			</div>

			<div class="raw-format-note">
				<code>format=raw</code>
				<p data-copy="rawDescription">{copy.rawDescription}</p>
			</div>

			<div class="payload-window">
				<div class="payload-title">normalized</div>
				<p class="payload-description" data-copy="normalizedDescription">
					{copy.normalizedDescription}
				</p>
				<div class="payload-code" set:html={normalizedPayloadHtml}></div>
			</div>
		</section>

		<section class="section" aria-labelledby="integration-title">
			<div class="section-heading">
				<h2 id="integration-title" data-copy="integrationHead">{copy.integrationHead}</h2>
				<span aria-hidden="true"></span>
			</div>

			<p class="integration-intro" data-copy="integrationIntro">{copy.integrationIntro}</p>

			<div class="integration-window">
				<div
					class="integration-tabs"
					role="tablist"
					aria-label={copy.integrationTabsLabel}
					data-copy-aria-label="integrationTabsLabel"
				>
					{
						integrationExamples.map((example) => (
							<button
								type="button"
								class="integration-tab"
								id={`integration-tab-${example.id}`}
								role="tab"
								aria-selected={example.id === 'python'}
								aria-controls={`integration-panel-${example.id}`}
								tabindex={example.id === 'python' ? 0 : -1}
								data-integration-tab={example.id}
							>
								{example.label}
							</button>
						))
					}
				</div>

				{
					integrationExamples.map((example) => (
						<div
							class="integration-panel"
							id={`integration-panel-${example.id}`}
							role="tabpanel"
							aria-labelledby={`integration-tab-${example.id}`}
							data-integration-panel={example.id}
							hidden={example.id !== 'python'}
						>
							<div class="integration-dependency">
								<span data-copy="dependencyLabel">{copy.dependencyLabel}</span>
								<code>{example.dependency}</code>
							</div>
							<div class="payload-code integration-code" set:html={example.html}></div>
						</div>
					))
				}
			</div>
		</section>

		<section class="section" aria-labelledby="pricing-title">
			<div class="section-heading">
				<h2 id="pricing-title" data-copy="prHead">{copy.prHead}</h2>
				<span aria-hidden="true"></span>
			</div>

			<div class="pricing-card">
				<div class="price-line">
					<span class="price">{price}€</span>
					<span class="price-period">/ <span data-copy="month">{copy.month}</span></span>
				</div>

				<ul class="feature-list">
					{
						copy.includes.map((line, index) => (
							<li>
								<span class="plus" aria-hidden="true">+</span>
								<span data-include-index={index}>{line}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<footer class="site-footer">
			<div class="terminal-contact">
				<span class="prompt" aria-hidden="true">$</span>
				<a href="mailto:insomnisdev@gmail.com">insomnisdev@gmail.com</a>
				<span class="cursor" aria-hidden="true">_</span>
			</div>
			<nav class="resource-links" aria-label={copy.resourcesLabel}>
				<a href="/vinted-api/">{copy.vintedLink}</a>
				<a href="/wallapop-api/">{copy.wallapopLink}</a>
			</nav>
			<p data-copy="legal">{copy.legal}</p>
		</footer>
	</div>
</main>

<script>
	const landing = document.querySelector<HTMLElement>('[data-landing]');

	if (landing) {
		const integrationTabs = landing.querySelectorAll<HTMLButtonElement>('[data-integration-tab]');
		const integrationPanels = landing.querySelectorAll<HTMLElement>('[data-integration-panel]');

		type IntegrationExampleId = 'node' | 'python' | 'rust';

		const isIntegrationExampleId = (value: string | undefined): value is IntegrationExampleId =>
			value === 'node' || value === 'python' || value === 'rust';

		const activateIntegration = (id: IntegrationExampleId, moveFocus = false) => {
			let activeTab: HTMLButtonElement | undefined;

			integrationTabs.forEach((tab) => {
				const isActive = tab.dataset.integrationTab === id;
				tab.setAttribute('aria-selected', String(isActive));
				tab.tabIndex = isActive ? 0 : -1;
				if (isActive) activeTab = tab;
			});

			integrationPanels.forEach((panel) => {
				panel.hidden = panel.dataset.integrationPanel !== id;
			});

			if (moveFocus) activeTab?.focus();
		};

		integrationTabs.forEach((tab, index) => {
			tab.addEventListener('click', () => {
				const id = tab.dataset.integrationTab;
				if (isIntegrationExampleId(id)) activateIntegration(id);
			});

			tab.addEventListener('keydown', (event) => {
				let nextIndex: number | undefined;

				if (event.key === 'ArrowRight') nextIndex = (index + 1) % integrationTabs.length;
				if (event.key === 'ArrowLeft') {
					nextIndex = (index - 1 + integrationTabs.length) % integrationTabs.length;
				}
				if (event.key === 'Home') nextIndex = 0;
				if (event.key === 'End') nextIndex = integrationTabs.length - 1;

				if (nextIndex === undefined) return;
				event.preventDefault();

				const nextId = integrationTabs.item(nextIndex).dataset.integrationTab;
				if (isIntegrationExampleId(nextId)) activateIntegration(nextId, true);
			});
		});

		activateIntegration('python');
	}
</script>

<style>
	@keyframes blink {
		0%,
		49% {
			opacity: 1;
		}

		50%,
		100% {
			opacity: 0;
		}
	}

	.landing {
		--background: #0c0e0d;
		--panel: #101312;
		--border: #232825;
		--text: #e4e9e5;
		--text-muted: #aab4ae;
		--text-dim: #78847d;
		--text-faint: #727d76;
		--accent: oklch(80% 0.14 155);
		--accent-bright: oklch(90% 0.14 155);

		min-height: 100vh;
		min-height: 100svh;
		padding: 56px 28px 96px;
		display: flex;
		justify-content: center;
		background: var(--background);
		color: var(--text);
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 15px;
		line-height: 1.7;
	}

	.shell {
		width: 100%;
		max-width: 760px;
		display: flex;
		flex-direction: column;
		gap: 64px;
	}

	.site-header,
	.contact-row,
	.section-heading,
	.price-line,
	.terminal-contact {
		display: flex;
		align-items: center;
	}

	.site-header {
		justify-content: space-between;
		gap: 24px;
	}

	.brand {
		display: flex;
		align-items: center;
	}

	.brand-logo {
		width: 210px;
		height: auto;
		display: block;
	}

	.market-status,
	.plus,
	.prompt,
	.cursor,
	.protocol {
		color: var(--accent);
	}

	.language-switcher {
		display: flex;
		gap: 2px;
	}

	.language-button {
		min-width: 44px;
		min-height: 38px;
		border: 1px solid var(--border);
		padding: 4px 10px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--panel);
		color: var(--text-dim);
		font: inherit;
		font-size: 13px;
		line-height: 1.7;
		transition:
			border-color 150ms ease,
			color 150ms ease,
			background 150ms ease;
	}

	.language-button:hover {
		color: var(--text);
		border-color: var(--text-dim);
	}

	.language-button[aria-current='page'] {
		border-color: var(--accent);
		background: color-mix(in oklch, var(--accent) 8%, var(--panel));
		color: var(--accent);
	}

	.language-button:focus-visible,
	.integration-tab:focus-visible,
	.payload-code :global(pre.shiki):focus-visible,
	a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.hero {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.command,
	.hero-copy,
	.integration-intro,
	.payload-description,
	.raw-format-note p,
	.site-footer p {
		margin: 0;
	}

	.command {
		color: var(--text-dim);
		font-size: 13px;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.125rem, 7vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.2;
		text-wrap: balance;
	}

	.hero-copy {
		max-width: 62ch;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.connection {
		border: 1px solid var(--border);
		padding: 18px 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		overflow-x: auto;
		background: var(--panel);
		font-size: 14px;
	}

	.connection code {
		font: inherit;
		white-space: nowrap;
	}

	.code-comment {
		color: var(--text-dim);
	}

	.contact-row {
		flex-wrap: wrap;
		gap: 14px;
	}

	a {
		color: var(--accent);
		text-decoration: none;
		transition:
			color 150ms ease,
			background 150ms ease;
	}

	a:hover {
		color: var(--accent-bright);
	}

	.primary-link {
		border: 1px solid var(--accent);
		padding: 10px 20px;
		font-weight: 500;
	}

	.primary-link:hover {
		background: var(--accent);
		color: var(--background);
	}

	.email-hint,
	.price-period {
		color: var(--text-dim);
	}

	.email-hint {
		font-size: 13px;
	}

	.section {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.section-heading {
		gap: 14px;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--text-dim);
		font-size: 13px;
		font-weight: 400;
		letter-spacing: 0.08em;
		line-height: 1.7;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.section-heading > span {
		flex: 1;
		height: 1px;
		background: var(--border);
	}

	.market-grid,
	.feature-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.market-grid {
		border: 1px solid var(--border);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		gap: 1px;
		background: var(--border);
	}

	.market-card {
		padding: 18px 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		background: var(--panel);
	}

	.market-name {
		font-weight: 500;
	}

	.market-status {
		font-size: 13px;
	}

	.payload-window {
		min-width: 0;
		border: 1px solid var(--border);
		background: var(--panel);
	}

	.raw-format-note {
		border: 1px solid var(--border);
		padding: 14px 18px;
		display: flex;
		align-items: baseline;
		gap: 12px;
		background: color-mix(in oklch, var(--accent) 4%, var(--panel));
	}

	.raw-format-note code,
	.payload-title {
		color: var(--accent);
		font: inherit;
		font-size: 12px;
	}

	.raw-format-note code {
		flex: none;
		white-space: nowrap;
	}

	.raw-format-note p {
		color: var(--text-dim);
		font-size: 12px;
		text-wrap: pretty;
	}

	.payload-title {
		border-bottom: 1px solid var(--border);
		padding: 12px 18px;
	}

	.payload-description {
		border-bottom: 1px solid var(--border);
		padding: 12px 18px;
		color: var(--text-dim);
		font-size: 12px;
	}

	.payload-code {
		width: 100%;
		max-width: 100%;
		max-height: 470px;
		margin: 0;
		overflow: auto;
		overscroll-behavior: contain;
		background: var(--panel);
		font-family: inherit;
		font-size: 12px;
		line-height: 1.6;
		scrollbar-color: var(--text-dim) var(--panel);
		tab-size: 2;
	}

	.payload-code :global(pre.shiki) {
		min-width: max-content;
		margin: 0;
		padding: 18px 20px;
		font: inherit;
		line-height: inherit;
		tab-size: inherit;
	}

	.payload-code :global(pre.shiki code) {
		font: inherit;
	}

	.integration-intro {
		max-width: 68ch;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.integration-window {
		min-width: 0;
		border: 1px solid var(--border);
		background: var(--panel);
	}

	.integration-tabs {
		border-bottom: 1px solid var(--border);
		display: flex;
		background: var(--background);
	}

	.integration-tab {
		min-height: 44px;
		border: 0;
		border-right: 1px solid var(--border);
		padding: 9px 16px;
		background: transparent;
		color: var(--text-dim);
		font: inherit;
		font-size: 13px;
		cursor: pointer;
		transition:
			background 150ms ease,
			color 150ms ease;
	}

	.integration-tab:hover {
		color: var(--text);
	}

	.integration-tab[aria-selected='true'] {
		background: var(--panel);
		color: var(--accent);
	}

	.integration-dependency {
		border-bottom: 1px solid var(--border);
		padding: 12px 18px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		color: var(--text-dim);
		font-size: 12px;
	}

	.integration-dependency code {
		max-width: 100%;
		padding: 3px 7px;
		overflow-x: auto;
		background: color-mix(in oklch, var(--accent) 7%, var(--background));
		color: var(--accent);
		font: inherit;
		white-space: nowrap;
		scrollbar-color: var(--text-dim) transparent;
	}

	.pricing-card {
		border: 1px solid var(--border);
		padding: 28px;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 40px;
		background: var(--panel);
	}

	.price-line {
		align-items: baseline;
		gap: 8px;
	}

	.price {
		font-size: 40px;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.feature-list {
		min-width: 260px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.feature-list li {
		display: flex;
		gap: 12px;
		color: var(--text-muted);
	}

	.site-footer {
		border-top: 1px solid var(--border);
		padding-top: 28px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.terminal-contact {
		align-items: baseline;
		gap: 8px;
	}

	.resource-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		font-size: 12px;
	}

	.cursor {
		animation: blink 1.1s step-end infinite;
	}

	.site-footer p {
		max-width: 70ch;
		color: var(--text-faint);
		font-size: 12px;
		text-wrap: pretty;
	}

	@media (max-width: 540px) {
		.landing {
			padding: 32px 18px 64px;
		}

		.shell {
			gap: 52px;
		}

		.brand-logo {
			width: 190px;
		}

		.market-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.integration-tab {
			flex: 1;
			padding-inline: 10px;
		}

		.integration-dependency {
			align-items: flex-start;
			flex-direction: column;
			gap: 5px;
		}

		.payload-code {
			max-height: 400px;
		}

		.payload-code :global(pre.shiki) {
			padding: 16px;
		}

		.pricing-card {
			padding: 22px 20px;
			gap: 28px;
		}

		.feature-list {
			min-width: 0;
			width: 100%;
		}
	}

	@media (max-width: 380px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.market-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}

		.language-button,
		.integration-tab,
		a {
			transition: none;
		}
	}
</style>
